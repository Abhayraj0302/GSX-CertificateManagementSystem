# ==============================================================================
# Certify - Certificate Management Platform Environment Configuration
# ==============================================================================
# Copy this file to `.env` before running docker compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Port Settings
# ------------------------------------------------------------------------------
PORT=3000
# Host port binding for MongoDB (bound to 127.0.0.1 for security)
MONGO_BIND_PORT=127.0.0.1:27017

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# For Docker Compose, the service name is `mongodb`:
MONGODB_URI=mongodb://mongodb:27017/certify
# If connecting to an external MongoDB or MongoDB Atlas instance, uncomment and set:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/certify?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. NextAuth Authentication & Session Security
# ------------------------------------------------------------------------------
# The canonical public URL of your application (NO trailing slash)
# Local: http://localhost:3000
# Production: https://certificates.yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Secret key used to encrypt session tokens and JWTs.
# Generate a secure 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# 4. Administrator Setup
# ------------------------------------------------------------------------------
# Comma-separated list of Google email addresses granted admin access
ADMIN_EMAIL=your-admin-google-email@gmail.com
ADMIN_NAME=Admin

# Automatically initialize and verify admin account on container startup
AUTO_SEED_ADMIN=true

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 Credentials (Required for Sign-in)
# ------------------------------------------------------------------------------
# Steps to obtain credentials:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID for a "Web Application"
# 3. Add Authorized Redirect URI:
#    - For local testing:  http://localhost:3000/api/auth/callback/google
#    - For production:     https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. Cloudinary (Required for Certificate Backgrounds & Image Uploads)
# ------------------------------------------------------------------------------
# Create a free account at: https://cloudinary.com
# Obtain these values from your Cloudinary Dashboard:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 7. Email Delivery Service (For Sending Issued Certificates)
# ------------------------------------------------------------------------------
# Sender details appearing in recipient emails:
EMAIL_FROM_ADDRESS=certificates@yourdomain.com
EMAIL_FROM_NAME=Certify

# Mailtrap API Token (Used for transactional email delivery)
MAILTRAP_TOKEN=your-mailtrap-api-token

# Resend API Key (Alternative email provider)
RESEND_API_KEY=re_your_resend_api_key
